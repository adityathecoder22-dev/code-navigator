# code-navigator settings. Copy to one of:
#   <your-repo>/.code-navigator.env           (per repository - add it to .gitignore if it holds a key)
#   ~/.config/code-navigator/config.env       (per user)
# Real environment variables override both files. With no settings at all, everything runs offline.

# ---------------- LLM (tree summaries, navigation, answers) ----------------
# none (default, offline) | ollama | openai (any OpenAI-compatible server) | anthropic
CODENAV_LLM_PROVIDER=none
# CODENAV_LLM_MODEL=qwen2.5-coder:7b
# CODENAV_LLM_BASE_URL=http://localhost:11434
# CODENAV_LLM_API_KEY=                  # or ANTHROPIC_API_KEY / OPENAI_API_KEY in the environment
# CODENAV_SUMMARY_LLM_MODEL=            # cheaper model for index-time summaries (default: LLM_MODEL; Haiku for anthropic)

# Local OpenAI-compatible server (llama.cpp, LM Studio, vLLM):
# CODENAV_LLM_PROVIDER=openai
# CODENAV_LLM_BASE_URL=http://localhost:8080/v1
# CODENAV_LLM_MODEL=qwen2.5-coder-7b-instruct
# CODENAV_LLM_API_KEY=local

# ---------------- Embeddings (vector search) ----------------
# hash (default, offline, keyword-like) | ollama | openai | sentence-transformers
CODENAV_EMBED_PROVIDER=hash
# CODENAV_EMBED_MODEL=nomic-embed-text
# CODENAV_EMBED_BASE_URL=http://localhost:11434

# ---------------- Vector database ----------------
# simple (numpy, default) | chroma | qdrant | lancedb | pgvector   (pip install "code-navigator[<name>]")
CODENAV_VECTOR_BACKEND=simple
# Server / remote location - required for pgvector, optional for qdrant and lancedb
# (without it they run embedded inside .code-navigator/vectors/):
# CODENAV_VECTOR_URL=postgresql://user:password@localhost:5432/codenav
# CODENAV_VECTOR_URL=http://localhost:6333            # Qdrant server
# CODENAV_VECTOR_URL=s3://bucket/codenav              # LanceDB on object storage
# CODENAV_VECTOR_API_KEY=                             # Qdrant Cloud / LanceDB Cloud
# CODENAV_VECTOR_COLLECTION=                          # default on a server: codenav_<project>

# ---------------- Index ----------------
# llm (default when an LLM is configured) | heuristic (no LLM calls, fast)
# CODENAV_SUMMARY_MODE=heuristic
# CODENAV_SUMMARY_WORKERS=4
# CODENAV_INCLUDE_TESTS=true
# CODENAV_CHUNK_MAX_LINES=120
# CODENAV_MAX_FILE_BYTES=300000

# ---------------- Retrieval ----------------
# hybrid (default) | vector | vectorless
# CODENAV_RETRIEVAL_MODE=hybrid
# CODENAV_TOP_K=8
# CODENAV_NAV_CONFIDENCE_THRESHOLD=0.6
# CODENAV_MAX_CONTEXT_CHARS=24000
# functions added to search results from the call graph (0 = off)
# CODENAV_CALL_EXPANSION=4
